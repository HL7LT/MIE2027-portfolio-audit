  "version": "0.2.0-ci",
  "name": "ObservationResultsLaboratoryEu",
  "title": "Observation Results: laboratory (Eu Lab)",
  "status": "draft",
  "experimental": false,
  "publisher": "HL7 Europe",
  "contact": [
    {
      "name": "HL7 Europe",
      "telecom": [
        {
          "system": "url",
          "value": "http://hl7.eu"
        }
      ]
    }
