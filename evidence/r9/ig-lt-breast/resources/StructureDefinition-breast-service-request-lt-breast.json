{
  "resourceType": "StructureDefinition",
  "id": "breast-service-request-lt-breast",
  "url": "https://hl7.lt/fhir/breast/StructureDefinition/breast-service-request-lt-breast",
  "name": "BreastServiceRequestLtBreast",
  "title": "Breast Examination Order",
  "status": "draft",
  "description": "A profile of ServiceRequest used to capture a clinical recommendation (e.g., follow-up ultrasound, surgical referral).",
  "fhirVersion": "5.0.0",
  "kind": "resource",
  "abstract": false,
  "type": "ServiceRequest",
  "baseDefinition": "https://hl7.lt/fhir/base/StructureDefinition/service-request-lt",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "ServiceRequest.code",
        "path": "ServiceRequest.code",
        "min": 1,
        "binding": {
          "strength": "required",
          "valueSet": "https://tx.hl7.lt/fhir/ValueSet/breast-recommendation"
        }
      },
      {
        "id": "ServiceRequest.subject",
        "path": "ServiceRequest.subject",
        "type": [
          {
            "code": "Reference",
            "targetProfile": [
              "https://hl7.lt/fhir/base/StructureDefinition/patient-lt"
            ]
          }
        ]
      },
      {
        "id": "ServiceRequest.occurrence[x]",
        "path": "ServiceRequest.occurrence[x]",
