        "id": "Observation.component:lesion.value[x]",
        "path": "Observation.component.value[x]",
        "min": 1,
        "type": [
          {
            "code": "CodeableConcept"
          }
        ],
        "binding": {
          "strength": "required",
          "valueSet": "https://tx.hl7.lt/fhir/ValueSet/ultrasound-lesion-finding"
        }
      },
      {
