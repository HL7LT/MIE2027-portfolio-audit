{
  "resourceType": "StructureDefinition",
  "id": "breast-ultrasound-finding-lt-breast",
  "language": "en",
  "url": "https://hl7.lt/fhir/breast/StructureDefinition/breast-ultrasound-finding-lt-breast",
  "name": "BreastUltrasoundFindingLtBreast",
  "title": "Breast Ultrasound Findings",
  "status": "active",
  "publisher": "HL7 Lithuania",
  "description": "A radiology observation representing one specific ultrasound lesion with localization, dimensions, and characteristics.",
  "fhirVersion": "5.0.0",
  "kind": "resource",
  "abstract": false,
  "type": "Observation",
  "baseDefinition": "https://hl7.lt/fhir/base/StructureDefinition/observation-lt",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Observation.category",
        "path": "Observation.category",
        "patternCodeableConcept": {
          "coding": [
            {
              "code": "imaging",
              "system": "http://terminology.hl7.org/CodeSystem/observation-category",
              "display": "Imaging"
            }
          ]
        }
      },
      {
        "id": "Observation.code",
        "path": "Observation.code",
        "patternCodeableConcept": {
          "coding": [
            {
              "code": "47079000",
              "system": "http://snomed.info/sct",
              "display": "Ultrasonography of breast (procedure)"
            }
          ]
        }
      },
      {
        "id": "Observation.subject",
        "path": "Observation.subject",
        "min": 1,
        "type": [
          {
            "code": "Reference",
            "targetProfile": [
              "https://hl7.lt/fhir/base/StructureDefinition/patient-lt"
            ]
          }
        ]
      },
      {
        "id": "Observation.effective[x]",
        "path": "Observation.effective[x]",
        "min": 1,
        "type": [
          {
            "code": "dateTime"
          }
        ]
      },
      {
        "id": "Observation.note",
        "path": "Observation.note",
        "short": "Lesion characteristics",
        "definition": "Free text description of shape, contour, echogenicity, homogeneity, vascularity, and elasticity."
      },
      {
        "id": "Observation.bodySite",
        "path": "Observation.bodySite",
        "mustSupport": true,
        "binding": {
          "strength": "required",
          "valueSet": "https://tx.hl7.lt/fhir/ValueSet/breast-body-site"
        }
      },
      {
        "id": "Observation.bodyStructure",
        "path": "Observation.bodyStructure",
        "type": [
          {
            "code": "Reference",
            "targetProfile": [
              "https://hl7.lt/fhir/breast/StructureDefinition/body-structure-lt-breast"
            ]
          }
        ]
      },
