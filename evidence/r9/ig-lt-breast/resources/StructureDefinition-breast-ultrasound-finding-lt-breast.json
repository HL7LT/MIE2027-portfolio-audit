          {
            "code": "Quantity",
            "profile": [
              "http://hl7.eu/fhir/imaging-r5/StructureDefinition/quantity-eu"
            ]
          }
        ],
        "patternQuantity": {
          "code": "mm",
          "system": "http://unitsofmeasure.org"
        }
      },
      {
        "id": "Observation.component:width-mm",
        "path": "Observation.component",
        "sliceName": "width-mm",
        "short": "Width of lesion",
        "definition": "The width of the lesion measured via ultrasound, typically in mm.",
        "min": 0,
        "max": "1"
      },
      {
        "id": "Observation.component:width-mm.code",
        "path": "Observation.component.code",
        "patternCodeableConcept": {
          "coding": [
            {
              "code": "440357003",
              "system": "http://snomed.info/sct",
              "display": "Width of structure by imaging measurement"
            }
          ]
        }
      },
      {
        "id": "Observation.component:width-mm.value[x]",
        "path": "Observation.component.value[x]",
        "min": 1,
        "type": [
          {
            "code": "Quantity",
            "profile": [
              "http://hl7.eu/fhir/imaging-r5/StructureDefinition/quantity-eu"
            ]
          }
        ],
        "patternQuantity": {
          "code": "mm",
          "system": "http://unitsofmeasure.org"
        }
      },
      {
        "id": "Observation.component:lymph-changes",
        "path": "Observation.component",
        "sliceName": "lymph-changes",
        "short": "Lymph node changes",
        "definition": "Whether changes in axillary lymph nodes are suspected.",
        "min": 0,
        "max": "1"
      },
      {
        "id": "Observation.component:lymph-changes.code",
        "path": "Observation.component.code",
        "patternCodeableConcept": {
          "coding": [
            {
              "code": "364108009",
              "system": "http://snomed.info/sct",
              "display": "Lymph node observable (observable entity)"
            }
          ]
        }
      },
      {
        "id": "Observation.component:lymph-changes.value[x]",
        "path": "Observation.component.value[x]",
        "min": 1,
        "type": [
          {
            "code": "CodeableConcept"
          }
        ],
        "binding": {
          "strength": "extensible",
          "valueSet": "http://hl7.org/fhir/ValueSet/observation-interpretation"
        }
      },
      {
        "id": "Observation.component:lymph-level",
        "path": "Observation.component",
        "sliceName": "lymph-level",
