              "system": "http://snomed.info/sct"
            }
          ]
        }
      },
      {
        "id": "Observation.component:lymph-largest-size.value[x]",
        "path": "Observation.component.value[x]",
        "min": 1,
        "type": [
          {
            "code": "Quantity"
