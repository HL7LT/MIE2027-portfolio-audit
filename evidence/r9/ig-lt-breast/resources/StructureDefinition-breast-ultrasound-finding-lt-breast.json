        "min": 1,
        "max": "1"
      },
      {
        "id": "Observation.component:clock-position.code",
        "path": "Observation.component.code",
        "patternCodeableConcept": {
          "coding": [
            {
              "code": "272485000",
              "system": "http://snomed.info/sct",
              "display": "Clockface position (qualifier value)"
