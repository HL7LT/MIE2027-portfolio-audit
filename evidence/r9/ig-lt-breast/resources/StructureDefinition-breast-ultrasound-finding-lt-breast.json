        "path": "Observation.component",
        "slicing": {
          "discriminator": [
            {
              "type": "value",
              "path": "code"
            }
          ],
          "rules": "open"
        },
        "min": 2
      },
      {
        "id": "Observation.component:lesion",
        "path": "Observation.component",
        "sliceName": "lesion",
        "short": "Lesion finding",
        "definition": "The side of the body (left or right) where the breast lesion is located.",
        "min": 1,
        "max": "1"
      },
      {
        "id": "Observation.component:lesion.code",
        "path": "Observation.component.code",
        "patternCodeableConcept": {
          "coding": [
            {
              "code": "364636000",
              "system": "http://snomed.info/sct",
              "display": "Lesion observable"
            }
          ]
        }
      },
