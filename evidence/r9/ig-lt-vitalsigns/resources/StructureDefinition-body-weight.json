  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Observation",
        "path": "Observation",
        "short": "Body Weight Profile (EE)",
        "definition": "This profile defines  how to represent body weight observations in FHIR using a standard LOINC code and UCUM units of measure.",
        "constraint": [
          {
            "key": "vs-bw-1",
            "human": "if Observation.effective[x] (as dateTime) has a value then that value shall be precise at least to the day",
            "source": "https://hl7.lt/fhir/vitalsigns/StructureDefinition/body-weight",
            "severity": "error",
            "expression": "(effective as dateTime).toString().length() >= 8"
          },
          {
            "key": "vs-bw-2",
            "human": "For single vital signs observations (that do not require use of components or hasMember), then either a value[x] or a data absent reason must be present.",
            "source": "https://hl7.lt/fhir/vitalsigns/StructureDefinition/body-weight",
            "severity": "error",
            "expression": "dataAbsentReason.exists() or value.exists()"
          }
        ]
      },
      {
        "id": "Observation.extension",
        "path": "Observation.extension",
        "slicing": {
          "discriminator": [
            {
              "type": "value",
              "path": "url"
            }
          ],
          "ordered": false,
          "rules": "open"
        }
      },
      {
        "id": "Observation.extension:associatedSituation",
        "path": "Observation.extension",
        "sliceName": "associatedSituation",
        "short": "Description of the state of dress of the person at the time of weighing",
        "min": 0,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": [
              "https://hl7.lt/fhir/vitalsigns/StructureDefinition/associated-situation"
            ]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Observation.extension:associatedSituation.value[x]",
        "path": "Observation.extension.value[x]",
        "type": [
          {
            "code": "CodeableConcept"
          }
        ]
      },
      {
        "id": "Observation.extension:associatedSituation.value[x]:valueCodeableConcept",
        "path": "Observation.extension.value[x]",
        "sliceName": "valueCodeableConcept",
        "type": [
          {
            "code": "CodeableConcept"
          }
        ],
        "binding": {
          "strength": "extensible",
          "valueSet": "https://tx.hl7.lt/fhir/ValueSet/body-weight-associated-situation"
        }
      },
      {
        "id": "Observation.extension:measurementSetting",
        "path": "Observation.extension",
        "sliceName": "measurementSetting",
        "short": "Measurement setting",
        "min": 0,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": [
              "https://hl7.lt/fhir/vitalsigns/StructureDefinition/measurement-setting"
            ]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Observation.category",
        "path": "Observation.category",
        "slicing": {
          "discriminator": [
            {
              "type": "pattern",
              "path": "$this"
            }
          ],
          "rules": "open"
        },
        "min": 2
      },
      {
        "id": "Observation.category:VSCat",
        "path": "Observation.category",
        "sliceName": "VSCat",
        "definition": "This vital signs category",
        "min": 1,
        "max": "1",
        "patternCodeableConcept": {
          "coding": [
            {
              "code": "vital-signs",
              "system": "http://terminology.hl7.org/CodeSystem/observation-category"
            }
          ]
        },
        "mustSupport": true
      },
      {
        "id": "Observation.category:BodyWeightCode",
        "path": "Observation.category",
        "sliceName": "BodyWeightCode",
        "definition": "This body weight category",
        "min": 1,
        "max": "1",
        "patternCodeableConcept": {
          "coding": [
            {
              "code": "29463-7",
              "system": "http://loinc.org"
            }
          ]
        },
        "mustSupport": true
      },
      {
        "id": "Observation.code",
        "path": "Observation.code",
        "short": "Body Weight",
        "definition": "Body Weight. LOINC required; SNOMED CT optional for dual coding."
      },
      {
        "id": "Observation.code.coding",
        "path": "Observation.code.coding",
        "slicing": {
          "discriminator": [
            {
              "type": "value",
              "path": "system"
            }
          ],
          "rules": "open"
        },
        "min": 1
      },
      {
        "id": "Observation.code.coding:LOINC",
        "path": "Observation.code.coding",
        "sliceName": "LOINC",
        "short": "Body Weight (LOINC)",
        "min": 1,
        "max": "1",
        "mustSupport": true,
        "binding": {
          "strength": "preferred",
          "valueSet": "https://tx.hl7.lt/fhir/ValueSet/body-weight-observation"
        }
      },
      {
        "id": "Observation.code.coding:LOINC.system",
        "path": "Observation.code.coding.system",
        "min": 1,
        "patternUri": "http://loinc.org"
      },
      {
        "id": "Observation.code.coding:SNOMED",
        "path": "Observation.code.coding",
        "sliceName": "SNOMED",
        "short": "Body Weight (SNOMED CT)",
        "min": 0,
        "max": "1",
        "binding": {
          "strength": "extensible",
          "valueSet": "https://tx.hl7.lt/fhir/ValueSet/body-weight-observation-snomed"
        }
      },
      {
        "id": "Observation.code.coding:SNOMED.system",
        "path": "Observation.code.coding.system",
        "min": 1,
        "patternUri": "http://snomed.info/sct"
      },
      {
        "id": "Observation.effective[x]",
        "path": "Observation.effective[x]",
        "short": "Vital Signs are point in time measurements and are recorded using the dateTime data type",
        "definition": "Vital Signs are point in time measurements and are recorded using the dateTime data type.",
        "min": 1,
        "type": [
          {
            "code": "dateTime"
          }
        ],
        "condition": [
          "vs-bw-1"
        ]
      },
      {
        "id": "Observation.value[x]",
        "path": "Observation.value[x]",
        "type": [
          {
            "code": "Quantity"
          }
        ],
        "condition": [
          "vs-bw-2",
          "obs-6"
        ],
        "binding": {
          "strength": "required",
          "valueSet": "http://hl7.org/fhir/ValueSet/ucum-bodyweight",
          "extension": [
            {
              "url": "http://hl7.org/fhir/tools/StructureDefinition/binding-definition",
              "valueMarkdown": "Common UCUM units for Body Weight."
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/elementdefinition-bindingName",
              "valueString": "BodyWeightUnits"
            }
          ],
          "description": "g | kg  | [lb_av]"
        }
      },
      {
        "id": "Observation.dataAbsentReason",
        "path": "Observation.dataAbsentReason",
        "condition": [
          "vs-bw-2"
        ]
      },
      {
        "id": "Observation.interpretation",
        "path": "Observation.interpretation",
        "binding": {
          "strength": "extensible",
          "valueSet": "https://tx.hl7.lt/fhir/ValueSet/numeric-result-interpretation-non-panic"
        }
      },
      {
        "id": "Observation.bodySite",
        "path": "Observation.bodySite",
        "max": "0"
      },
      {
        "id": "Observation.bodyStructure",
        "path": "Observation.bodyStructure",
        "max": "0"
      },
      {
        "id": "Observation.device",
        "path": "Observation.device",
        "short": "Body Weight Measurement Device",
        "type": [
          {
            "code": "Reference",
            "targetProfile": [
              "https://hl7.lt/fhir/vitalsigns/StructureDefinition/device-body-weight"
            ]
          }
        ]
      },
      {
        "id": "Observation.component",
        "path": "Observation.component",
        "max": "0"
      }
    ]
