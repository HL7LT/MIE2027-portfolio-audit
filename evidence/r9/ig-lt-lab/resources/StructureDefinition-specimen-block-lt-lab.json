              "display": "Tissue block specimen (specimen)"
            }
          ]
        }
      },
      {
        "id": "Specimen.type.text",
        "path": "Specimen.type.text",
        "patternString": "Paraffin embedded block"
      },
      {
        "id": "Specimen.subject",
        "path": "Specimen.subject",
        "type": [
          {
            "code": "Reference",
            "targetProfile": [
              "https://hl7.lt/fhir/base/StructureDefinition/patient-lt",
              "http://hl7.eu/fhir/base-r5/StructureDefinition/patient-animal-eu-core"
            ]
          }
        ]
      },
      {
        "id": "Specimen.parent",
        "path": "Specimen.parent",
