        "path": "Specimen.accessionIdentifier",
        "short": "The lab-assigned block ID (e.g., A1, B2)",
        "mustSupport": true
      },
      {
        "id": "Specimen.accessionIdentifier.use",
        "path": "Specimen.accessionIdentifier.use",
        "patternCode": "secondary"
      },
      {
        "id": "Specimen.type",
        "path": "Specimen.type",
        "patternCodeableConcept": {
          "coding": [
            {
              "code": "1201985008",
