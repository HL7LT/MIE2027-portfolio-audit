  "name": "SpecimenBlockLtLab",
  "title": "Specimen: Tissue Block",
  "status": "draft",
  "description": "A profile for paraffin-embedded tissue blocks derived from a parent specimen.",
  "fhirVersion": "5.0.0",
  "kind": "resource",
  "abstract": false,
