            }
          ],
          "code": "bioptate-length-mm",
          "display": "Bioptate length (mm)"
        },
        {
          "target": [
            {
              "code": "specimen-adequacy-finding",
              "relationship": "related-to",
              "comment": "Observation-observation-specimen-adequacy-example (LT Lab); map answerCoding to SNOMED finding codes from national spec."
            }
          ],
          "code": "specimen-quality",
          "display": "Quality of materials"
        },
        {
          "target": [
            {
              "code": "tumor-observable-lt-lab",
              "relationship": "related-to",
              "comment": "TumorObservableLtLab or narrative in DiagnosticReport; map radiotherapy/hormone SNOMED from spreadsheet."
            }
          ],
          "code": "treatment-effect",
          "display": "Treatment effect on tumour"
        },
        {
          "target": [
            {
              "code": "prostate-condition-lt-lab",
              "relationship": "related-to",
              "comment": "Condition.code / morphology; Condition-condition-prostate-cancer-example (LT Lab) for integrated staging."
            }
          ],
          "code": "histological-type",
          "display": "Primary histological type"
        },
        {
          "target": [
            {
              "code": "prostate-condition-lt-lab",
