          ],
          "code": "cribriform-status",
          "display": "Cribriform glands"
        },
        {
          "target": [
            {
              "code": "observation-pattern4-percent",
              "relationship": "related-to",
              "comment": "TumorMeasurementLtLab or lab tumour Observation; dr-prostate has finer bands than this Questionnaire."
            }
          ],
          "code": "pattern4-pct-band",
          "display": "Pattern 4 quantity (percent band)"
        },
        {
          "target": [
            {
              "code": "observation-tumor-burden-percent",
              "relationship": "related-to",
              "comment": "Quantitative tumour assessment row in dr-prostate; map to Observation ratio or coded category."
            }
          ],
          "code": "tumor-percent-in-biopsy",
          "display": "Tumour percentage in biopsy tissue"
        },
        {
          "target": [
            {
              "code": "observation-periprostatic-invasion",
