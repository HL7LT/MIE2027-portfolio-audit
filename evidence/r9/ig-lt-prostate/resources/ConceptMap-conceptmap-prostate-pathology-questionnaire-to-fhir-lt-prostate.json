          ],
          "code": "periprostatic-fat-invasion",
          "display": "Periprostatic fat invasion"
        },
        {
          "target": [
            {
              "code": "observation-perineural-invasion",
              "relationship": "related-to",
              "comment": "SNOMED 369731000 (present), 370051000 (absent), 385001000 (not identified), 396393005 (indeterminate); use LT Lab tumour findings."
