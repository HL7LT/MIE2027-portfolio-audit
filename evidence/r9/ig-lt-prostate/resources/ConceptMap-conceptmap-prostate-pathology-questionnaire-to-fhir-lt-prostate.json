          ],
          "code": "perineural-invasion",
          "display": "Perineural invasion"
        },
        {
          "target": [
            {
              "code": "observation-lymphovascular-invasion",
              "relationship": "related-to",
              "comment": "SNOMED 385414009 Lymphatic (small vessel) tumor invasion finding; use LT Lab tumour findings for biopsy microscopic assessment."
            }
          ],
          "code": "lymphovascular-invasion",
          "display": "Lymphatic and/or vascular tumour invasion"
        }
      ],
      "source": "https://tx.hl7.lt/fhir/CodeSystem/prostate-pathology-questionnaire-item",
