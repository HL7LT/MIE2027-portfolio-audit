  "title": "ADPP Questionnaire items to FHIR mapping",
  "description": "Maps ADPP primary assessment Questionnaire linkIds to LT Base / VitalSigns / Lifestyle / Lab patterns. Not a substitute for $extract or national transform logic.",
  "group": [
    {
      "element": [
        {
          "target": [
            {
              "code": "encounter-period",
              "display": "Encounter.period",
              "relationship": "related-to",
              "comment": "Maps to EncounterLt.period (or effectiveDateTime on Observations created in this visit). Example: Encounter-encounter-prostate-diagnostic-example."
            }
          ],
          "code": "assessment-datetime",
          "display": "Assessment date and time"
        },
        {
          "target": [
            {
              "code": "servicerequest-reason",
              "display": "ServiceRequest.reasonCode",
              "relationship": "related-to",
              "comment": "Populate ServiceRequestLt.reasonCode or Encounter.reasonCode. Example: ServiceRequest-servicerequest-pathology-prostate-order-example (LT Lab CI)."
            }
          ],
          "code": "referral-reason",
          "display": "Reason for referral / programme entry"
        },
        {
          "target": [
            {
              "code": "observation-lt",
              "display": "Observation: PSA LOINC 2857-1",
              "relationship": "related-to",
              "comment": "Boolean flag; actual value is ObservationLt with LOINC 2857-1. Example: Observation-observation-prostate-psa-example."
            }
          ],
          "code": "psa-recorded",
          "display": "PSA measured at this visit (flag)"
        },
        {
          "target": [
            {
              "code": "observation-lt",
              "display": "Observation: DRE finding",
              "relationship": "related-to",
              "comment": "No dedicated DRE profile in LT Prostate; use ObservationLt (exam) with SNOMED or national codes. National spreadsheets add texture options (e.g. 276385001 Soft prostate) — extend answerOption and map to valueCodeableConcept."
            }
          ],
          "code": "dre-result",
          "display": "Digital rectal examination (summary)"
        },
        {
          "target": [
            {
              "code": "family-member-history-cancer",
              "display": "FamilyMemberHistory",
              "relationship": "related-to",
              "comment": "Use FamilyMemberHistory with SNOMED situation codes (e.g. 414205003) as in national form notes. LT Base FamilyMemberHistory if profiled."
            }
          ],
          "code": "family-hx-prostate",
          "display": "Family history: prostate cancer"
        },
        {
          "target": [
            {
              "code": "family-member-history-cancer",
              "relationship": "related-to",
              "comment": "Same as family-hx-prostate; different relationship code."
