        "path": "DiagnosticReport.category",
        "short": "Diagnostic service section; CTG (Cardiology) reflects the cardiovascular nature of this screening programme report.",
        "min": 1,
        "max": "1",
        "patternCodeableConcept": {
          "coding": [
            {
              "code": "OTH",
