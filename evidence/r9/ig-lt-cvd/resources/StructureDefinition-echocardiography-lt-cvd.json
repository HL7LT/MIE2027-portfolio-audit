{
  "resourceType": "StructureDefinition",
  "id": "echocardiography-lt-cvd",
  "language": "en",
  "url": "https://hl7.lt/fhir/cvd/StructureDefinition/echocardiography-lt-cvd",
  "version": "1.0.0",
  "name": "EchocardiographyLtCvd",
  "title": "Echocardiography",
  "status": "draft",
  "experimental": true,
  "publisher": "HL7 Lithuania",
  "description": "Echocardiography observation for CVD screening.\nCaptures left ventricular ejection fraction (EF), EF category, and optional established pathology (ICD-10).",
  "fhirVersion": "5.0.0",
  "kind": "resource",
  "abstract": false,
  "type": "Observation",
  "baseDefinition": "https://hl7.lt/fhir/base/StructureDefinition/observation-lt",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Observation.category",
        "path": "Observation.category",
        "patternCodeableConcept": {
          "coding": [
            {
              "code": "procedure",
              "system": "http://terminology.hl7.org/CodeSystem/observation-category",
              "display": "Procedure"
            }
          ]
        }
      },
      {
        "id": "Observation.code",
        "path": "Observation.code",
        "patternCodeableConcept": {
          "coding": [
            {
              "code": "40701008",
              "system": "http://snomed.info/sct",
              "display": "Echocardiography (procedure)"
            }
          ]
        }
      },
      {
        "id": "Observation.subject",
        "path": "Observation.subject",
        "min": 1,
        "type": [
          {
            "code": "Reference",
            "targetProfile": [
              "https://hl7.lt/fhir/base/StructureDefinition/patient-lt"
            ]
          }
        ]
      },
      {
        "id": "Observation.effective[x]",
        "path": "Observation.effective[x]",
        "min": 1,
        "type": [
          {
            "code": "dateTime"
          }
        ]
      },
      {
        "id": "Observation.value[x]",
        "path": "Observation.value[x]",
        "max": "0"
      },
      {
        "id": "Observation.component",
        "path": "Observation.component",
        "slicing": {
          "discriminator": [
            {
              "type": "pattern",
              "path": "code"
            }
          ],
          "rules": "open"
        },
        "min": 2
      },
      {
        "id": "Observation.component:ejectionFraction",
        "path": "Observation.component",
        "sliceName": "ejectionFraction",
        "short": "Left ventricular ejection fraction (%)",
        "min": 1,
        "max": "1",
        "mustSupport": true
      },
      {
        "id": "Observation.component:ejectionFraction.code",
        "path": "Observation.component.code",
        "patternCodeableConcept": {
          "coding": [
            {
              "code": "250908004",
              "system": "http://snomed.info/sct",
              "display": "Left ventricular ejection fraction (observable entity)"
            }
          ]
        }
      },
      {
        "id": "Observation.component:ejectionFraction.value[x]",
        "path": "Observation.component.value[x]",
        "type": [
          {
            "code": "Quantity"
          }
        ]
      },
      {
        "id": "Observation.component:ejectionFraction.value[x].unit",
        "path": "Observation.component.value[x].unit",
        "patternString": "%"
      },
      {
        "id": "Observation.component:ejectionFraction.value[x].system",
        "path": "Observation.component.value[x].system",
        "patternUri": "http://unitsofmeasure.org"
      },
      {
        "id": "Observation.component:ejectionFraction.value[x].code",
        "path": "Observation.component.value[x].code",
        "patternCode": "%"
      },
      {
        "id": "Observation.component:efCategory",
        "path": "Observation.component",
        "sliceName": "efCategory",
        "short": "EF category: preserved (>= 50%), mildly reduced (41-49%), reduced (<= 40%)",
        "min": 1,
        "max": "1",
        "mustSupport": true
      },
      {
        "id": "Observation.component:efCategory.code",
        "path": "Observation.component.code",
        "patternCodeableConcept": {
          "coding": [
            {
              "code": "70822001",
              "system": "http://snomed.info/sct",
              "display": "Cardiac ejection fraction, function (observable entity)"
            }
          ]
        }
      },
      {
        "id": "Observation.component:efCategory.value[x]",
        "path": "Observation.component.value[x]",
        "type": [
          {
            "code": "CodeableConcept"
          }
        ],
        "binding": {
          "strength": "required",
          "valueSet": "https://tx.hl7.lt/fhir/ValueSet/ejection-fraction-category"
        }
      },
      {
        "id": "Observation.component:pathology",
        "path": "Observation.component",
        "sliceName": "pathology",
        "short": "Established cardiovascular pathology (ICD-10 code)",
        "min": 0,
        "max": "1",
        "mustSupport": true
      },
      {
        "id": "Observation.component:pathology.code",
        "path": "Observation.component.code",
        "patternCodeableConcept": {
          "coding": [
            {
              "code": "106063007",
              "system": "http://snomed.info/sct",
              "display": "Cardiovascular finding (finding)"
            }
          ]
        }
      },
      {
        "id": "Observation.component:pathology.value[x]",
        "path": "Observation.component.value[x]",
        "type": [
          {
            "code": "CodeableConcept"
          }
        ]
      }
    ]
  }
}
