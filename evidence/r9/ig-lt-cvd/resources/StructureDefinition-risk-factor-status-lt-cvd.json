{
  "resourceType": "StructureDefinition",
  "id": "risk-factor-status-lt-cvd",
  "language": "en",
  "url": "https://hl7.lt/fhir/cvd/StructureDefinition/risk-factor-status-lt-cvd",
  "version": "1.0.0",
  "name": "RiskFactorStatusLtCvd",
  "title": "Risk Factor Status",
  "status": "draft",
  "experimental": true,
  "date": "2025-10-26T11:00:00+03:00",
  "publisher": "HL7 Lithuania",
  "description": "Generic structure for recording Screening-related risk factors,\nsuch as hypertension, diabetes, or dyslipidemia.\nCaptures both the assessed risk probability and the treatment status.",
  "fhirVersion": "5.0.0",
  "kind": "resource",
  "abstract": false,
  "type": "Observation",
  "baseDefinition": "https://hl7.lt/fhir/base/StructureDefinition/observation-lt",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Observation.category",
        "path": "Observation.category",
        "patternCodeableConcept": {
          "coding": [
            {
              "code": "exam",
              "system": "http://terminology.hl7.org/CodeSystem/observation-category",
              "display": "Exam"
            }
          ]
        }
      },
      {
        "id": "Observation.code",
        "path": "Observation.code",
        "short": "Type of risk factor (e.g., hypertension, diabetes, dyslipidemia)",
        "binding": {
          "strength": "extensible",
          "valueSet": "https://tx.hl7.lt/fhir/ValueSet/risk-factor-type"
        }
      },
      {
        "id": "Observation.subject",
        "path": "Observation.subject",
        "min": 1,
        "type": [
          {
            "code": "Reference",
            "targetProfile": [
              "https://hl7.lt/fhir/base/StructureDefinition/patient-lt"
            ]
          }
        ]
      },
      {
        "id": "Observation.effective[x]",
        "path": "Observation.effective[x]",
        "comment": "The date and time when risk factor status or risk was assessed.",
        "min": 1,
        "type": [
          {
            "code": "dateTime"
          }
        ]
      },
      {
        "id": "Observation.component",
        "path": "Observation.component",
        "slicing": {
          "discriminator": [
            {
              "type": "value",
              "path": "code"
            }
          ],
          "rules": "open",
          "description": "Slice based on the component.code pattern"
        },
        "min": 1,
        "max": "3"
      },
      {
        "id": "Observation.component:risk",
        "path": "Observation.component",
        "sliceName": "risk",
        "short": "Assessed risk probability or certainty level.",
        "min": 1,
        "max": "1",
        "mustSupport": true
      },
      {
        "id": "Observation.component:risk.code",
        "path": "Observation.component.code",
        "patternCodeableConcept": {
          "coding": [
            {
              "code": "80943009",
              "system": "http://snomed.info/sct",
              "display": "Risk factor"
            }
          ]
        }
      },
      {
        "id": "Observation.component:risk.value[x]",
        "path": "Observation.component.value[x]",
        "type": [
          {
            "code": "CodeableConcept"
          }
        ],
        "binding": {
          "strength": "extensible",
          "valueSet": "http://hl7.org/fhir/ValueSet/risk-probability"
        }
      },
      {
        "id": "Observation.component:treatment",
        "path": "Observation.component",
        "sliceName": "treatment",
        "short": "Indicates whether treatment has been given or not.",
        "min": 0,
        "max": "1",
        "mustSupport": true
      },
      {
        "id": "Observation.component:treatment.code",
        "path": "Observation.component.code",
        "patternCodeableConcept": {
          "coding": [
            {
              "code": "443938003",
              "system": "http://snomed.info/sct",
              "display": "Procedure carried out on subject"
            }
          ]
        }
      },
      {
        "id": "Observation.component:treatment.value[x]",
        "path": "Observation.component.value[x]",
        "type": [
          {
            "code": "CodeableConcept"
          }
        ],
        "binding": {
          "strength": "extensible",
          "valueSet": "https://tx.hl7.lt/fhir/ValueSet/treatment-status"
        }
      },
      {
        "id": "Observation.component:medication",
        "path": "Observation.component",
        "sliceName": "medication",
        "short": "Indicates whether medication has been taken or not.",
        "min": 0,
        "max": "1",
        "mustSupport": true
      },
      {
        "id": "Observation.component:medication.code",
        "path": "Observation.component.code",
        "patternCodeableConcept": {
          "coding": [
            {
              "code": "129019007",
              "system": "http://snomed.info/sct",
              "display": "Taking medication (observable entity)"
            }
          ]
        }
      },
      {
        "id": "Observation.component:medication.value[x]",
        "path": "Observation.component.value[x]",
        "type": [
          {
            "code": "CodeableConcept"
          }
        ],
        "binding": {
          "strength": "extensible",
          "valueSet": "https://tx.hl7.lt/fhir/ValueSet/medication-taken"
        }
      }
    ]
  }
}
