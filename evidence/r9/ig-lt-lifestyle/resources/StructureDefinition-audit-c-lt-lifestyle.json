{
  "resourceType": "StructureDefinition",
  "id": "audit-c-lt-lifestyle",
  "language": "en",
  "url": "https://hl7.lt/fhir/lifestyle/StructureDefinition/audit-c-lt-lifestyle",
  "version": "1.0.0",
  "name": "AuditCLtLifestyle",
  "title": "AUDIT-C Total Score",
  "status": "draft",
  "experimental": true,
  "publisher": "HL7 Lithuania",
  "description": "AUDIT-C total score (0–12) as a quantitative Observation; linked to QuestionnaireResponse if necessary.",
  "fhirVersion": "5.0.0",
  "kind": "resource",
  "abstract": false,
  "type": "Observation",
  "baseDefinition": "https://hl7.lt/fhir/base/StructureDefinition/observation-lt",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Observation",
        "path": "Observation",
        "constraint": [
          {
            "key": "auditc-range",
            "severity": "error",
            "human": "AUDIT-C score must be between 0 and 12 inclusive.",
            "expression": "value.ofType(Quantity).value.all($this >= 0 and $this <= 12)",
            "source": "https://hl7.lt/fhir/lifestyle/StructureDefinition/audit-c-lt-lifestyle"
          },
          {
            "key": "auditc-ucum",
            "severity": "error",
            "human": "AUDIT-C score must use UCUM {score}.",
            "expression": "value.ofType(Quantity).all(system = 'http://unitsofmeasure.org' and code = '{score}')",
            "source": "https://hl7.lt/fhir/lifestyle/StructureDefinition/audit-c-lt-lifestyle"
          }
        ]
      },
      {
        "id": "Observation.category",
        "path": "Observation.category",
        "patternCodeableConcept": {
          "coding": [
            {
              "code": "survey",
              "system": "http://terminology.hl7.org/CodeSystem/observation-category",
              "display": "Survey"
            }
          ]
        }
      },
      {
        "id": "Observation.code.coding",
        "path": "Observation.code.coding",
        "slicing": {
          "discriminator": [
            {
              "type": "value",
              "path": "system"
            }
          ],
          "rules": "open"
        },
        "min": 1
      },
      {
        "id": "Observation.code.coding:loincCode",
        "path": "Observation.code.coding",
        "sliceName": "loincCode",
        "min": 1,
        "max": "1",
        "patternCoding": {
          "code": "75626-2",
          "system": "http://loinc.org",
          "display": "Total score [AUDIT-C]"
        }
      },
      {
        "id": "Observation.code.coding:loincCode.system",
        "path": "Observation.code.coding.system",
        "min": 1,
        "patternUri": "http://loinc.org"
      },
      {
        "id": "Observation.code.coding:sctCode",
        "path": "Observation.code.coding",
        "sliceName": "sctCode",
        "min": 0,
        "max": "1",
        "patternCoding": {
          "code": "763256006",
          "system": "http://snomed.info/sct",
          "display": "Alcohol Use Disorders Identification Test - Consumption score (observable entity)"
        }
      },
      {
        "id": "Observation.code.coding:sctCode.system",
        "path": "Observation.code.coding.system",
        "min": 1,
        "patternUri": "http://snomed.info/sct"
      },
      {
        "id": "Observation.subject",
        "path": "Observation.subject",
        "min": 1,
        "type": [
          {
            "code": "Reference",
            "targetProfile": [
              "https://hl7.lt/fhir/base/StructureDefinition/patient-lt"
            ]
          }
        ]
      },
      {
        "id": "Observation.effective[x]",
        "path": "Observation.effective[x]",
        "min": 1,
        "type": [
          {
            "code": "dateTime"
          }
        ]
      },
      {
        "id": "Observation.value[x]",
        "path": "Observation.value[x]",
        "min": 1,
        "type": [
          {
            "code": "Quantity"
          }
        ]
      },
      {
        "id": "Observation.value[x].system",
        "path": "Observation.value[x].system",
        "patternUri": "http://unitsofmeasure.org"
      },
      {
        "id": "Observation.value[x].code",
        "path": "Observation.value[x].code",
        "patternCode": "{score}"
      },
      {
        "id": "Observation.derivedFrom",
        "path": "Observation.derivedFrom",
        "short": "QuestionnaireResponse",
        "max": "1",
        "type": [
          {
            "code": "Reference",
            "targetProfile": [
              "http://hl7.org/fhir/StructureDefinition/QuestionnaireResponse"
            ]
          }
        ]
      }
    ]
  }
}
